# Host ports. Change FRONTEND_PORT to 3001 if npm run dev already uses 3000.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Browser-visible backend URL. It must use the host port above.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000

# The working hackathon demo uses deterministic repository-owned samples.
AGNES_MODE=fixture
USE_SAMPLE_FALLBACK=true

# Switch to live only after implementing the private Agnes HTTP protocol.
AGNES_API_KEY=
AGNES_BASE_URL=

ENVIRONMENT=development
STORE_SCANNED_IMAGES_BY_DEFAULT=false
