# Host ports. Change FRONTEND_PORT to 3001 if npm run dev already uses 3000.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Browser-visible backend URL. It must use the host port above.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Vercel frontend builds use this server-side proxy target instead.
BACKEND_ORIGIN=
FRONTEND_ORIGINS=http://localhost:3000

# Use fixture for deterministic samples, or live for Agnes image analysis.
AGNES_MODE=fixture
USE_SAMPLE_FALLBACK=true

# Credentials stay backend-only and are never exposed to Next.js.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_TIMEOUT_SECONDS=30

# Optional cloud text-to-speech. The browser voice remains the fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_TIMEOUT_SECONDS=20

ENVIRONMENT=development
STORE_SCANNED_IMAGES_BY_DEFAULT=false
