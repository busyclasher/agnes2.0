    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.4.21",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "overrides": {
